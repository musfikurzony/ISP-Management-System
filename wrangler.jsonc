// Cloudflare configuration for the ISP Billing application (Cloudflare Pages).
// "DB" is the name the code uses to reach the D1 database.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "isp-billing",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-06-01",

  // PRODUCTION (the live site, built from the "main" branch)
  "vars": { "APP_ENV": "production" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "isp_billing_db",
      "database_id": "54b72455-5266-4f70-8880-33a07bff7253",
      "migrations_dir": "migrations"
    }
  ],

  "env": {
    // PREVIEW (test copies built from other branches) uses a separate database,
    // so experiments can never touch real customer data.
    "preview": {
      "vars": { "APP_ENV": "preview" },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "isp_billing_db_preview",
          "database_id": "a727138d-722f-4d92-8765-c1dbd7c39289",
          "migrations_dir": "migrations"
        }
      ]
    }
  }
}
