{
  "name": "isp-billing",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run build && wrangler pages dev --port 8788",
    "dev:ui": "vite",
    "build": "vite build",
    "db:migrate:local": "wrangler d1 migrations apply isp_billing_db --local",
    "db:migrate:remote": "wrangler d1 migrations apply isp_billing_db --remote",
    "deploy": "npm run build && wrangler pages deploy",
    "backup": "wrangler d1 export isp_billing_db --remote --output=backup.sql",
    "test": "node tests/smoke.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "recharts": "^2.13.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0",
    "vite": "^6.0.0",
    "wrangler": "^4.0.0"
  }
}
